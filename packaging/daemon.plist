<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.newbie.ioshotspot</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/ioshotspotd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/com.newbie.ioshotspot/service.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/com.newbie.ioshotspot/service.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>root</string>
</dict>
</plist>
